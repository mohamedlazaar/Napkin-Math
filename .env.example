# Copy to .env.local and fill in.

# Absolute origin of the deployed site. Used for canonical URLs, OpenGraph and
# sitemap.xml. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: Google Search Console HTML-tag verification token (the `content`
# value only, not the whole meta tag). This is Search Console, not ads — it is
# how you submit your sitemap, and it is unrelated to any ad network.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Ad network config is NOT an env var — it lives in data/ad-network.ts, because
# ad snippets are multi-line HTML rather than simple key/value strings.
